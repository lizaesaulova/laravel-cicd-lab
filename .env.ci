APP_NAME="Laravel CI/CD Lab"
APP_ENV=testing
APP_KEY=
# The CI workflow generates a temporary APP_KEY with `php artisan key:generate --force`.
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=:memory:
DB_USERNAME=null
DB_PASSWORD=null

CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
